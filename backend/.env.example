# backend/.env.example —— 环境变量示例
# 复制为 .env 并按需修改

# 数据库连接串（SQLAlchemy 格式）
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/english_edit

# Redis 连接串
REDIS_URL=redis://localhost:6379/0

# Langfuse 可观测性配置（可为空则关闭追踪）
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# OpenAI 兼容的云 API 配置
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=

# 成本估算单价（每 1000 token）
COST_PER_1K_TOKENS=0.002

# 质检采样轮数（降低抖动，默认 1：rubric 已使单次打分稳定；需降噪时调高）
JUDGE_SAMPLE_ROUNDS=1
JUDGE_MAX_RETRIES=3
# 空值回退生成模型；建议显式使用不同的 Judge 模型
JUDGE_MODEL_NAME=

# 人工质检默认阈值
QUALITY_THRESHOLD=70
# P1: Explicit tier mapping, independent Judge endpoint, and constrained CORS
MODEL_PROFILE_MODELS={}
REQUIRE_DISTINCT_MODEL_TIERS=false
REQUIRE_INDEPENDENT_JUDGE=false
JUDGE_API_BASE=
JUDGE_API_KEY=
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]
CORS_ALLOW_CREDENTIALS=false
RAG_MODE=optional
RAG_MIN_SIMILARITY=0.3

# Trace durability: mount this directory on a durable volume in production
TRACE_FAILURE_SPOOL_DIR=
TRACE_REQUIRE_DURABILITY=false

# RAG P0 A/B/C — only new ingestions use these strategies; old vectors are not rebuilt.
RAG_CHUNK_STRATEGY=auto
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=80
RAG_CHUNK_MIN_CHARS=80
# Optional UTF-8 byte-conservative token budget, including heading/table context.
# RAG_CHUNK_TOKEN_LIMIT=1024
RAG_EMBEDDING_BATCH_SIZE=32

# RAG P1 DEF — only new ingestion gets parent/child; old vectors are not re-embedded.
RAG_PARENT_CHILD_ENABLED=true
RAG_PARENT_MIN_CHARS=1024
RAG_PARENT_SIZE=2048
RAG_NEIGHBOR_WINDOW=1
RAG_CONTEXT_MAX_CHARS=32768
RAG_CONTEXT_EXPANSION_LIMIT=24
# relation: small leaf seeds -> source-segment bundles. legacy: unchanged v1 context.
RAG_CONTEXT_MODE=relation
RAG_STRUCTURE_ENABLED=true
RAG_STRUCTURE_MAX_BLOCKS=10000
RAG_STRUCTURE_MAX_LEAFS=2000
RAG_CONTEXT_BUNDLE_MAX_MEMBERS=24
RAG_CONTEXT_BUNDLE_MAX_HOPS=32
RAG_CONTEXT_MAX_SEGMENTS=128
# Optional UTF-8 byte bound, not tokenizer-measured model tokens; unset by default.
# RAG_CONTEXT_TOKEN_LIMIT=131072
RAG_CANDIDATE_POOL=30
RAG_TOP_K=5
RAG_RETRIEVAL_METHOD=hybrid
RAG_RRF_K=60
RAG_KEYWORD_MIN_SCORE=0.001
# Chinese lexical fallback: bigram = bounded overlapping CJK pairs; legacy = old whole-run matching.
RAG_CJK_KEYWORD_MODE=bigram
RAG_KEYWORD_MAX_TERMS=32
# Re-ranker endpoints accept Cohere/Jina-style JSON. Optional fallback / required fail-closed.
RAG_RERANK_MODE=off
RAG_RERANK_URL=
RAG_RERANK_API_KEY=
RAG_RERANK_MODEL=
RAG_RERANK_TIMEOUT=10
RAG_RERANK_THRESHOLD=0
# Empty catalog path uses backend/app/rag/knowledge_points.yml (not tenant authorization).
RAG_KNOWLEDGE_CATALOG=
RAG_KNOWLEDGE_SCOPE=exact
RAG_KNOWLEDGE_SCOPE_MAX=128
# off / aliases (no chat calls) / llm (bounded optional rewrite; fallback to original/aliases).
RAG_QUERY_EXPANSION_MODE=aliases
RAG_QUERY_EXPANSION_MAX=4
RAG_QUERY_EXPANSION_MAX_OUTPUT_TOKENS=512
RAG_QUERY_EXPANSION_MODEL=
RAG_QUERY_EXPANSION_API_BASE=
RAG_QUERY_EXPANSION_API_KEY=
RAG_QUERY_EXPANSION_TIMEOUT=8

# Explicit local OCR; does not enable OCR in synchronous HTTP preview/upload.
RAG_OCR_ENGINE=off
RAG_OCR_URL=
RAG_OCR_API_KEY=
RAG_OCR_PAGE_TIMEOUT=180
RAG_OCR_MAX_PAGES=3
RAG_OCR_MAX_INPUT_BYTES=134217728
RAG_OCR_MAX_RESULT_BYTES=4194304
RAG_PDF_MIN_TEXT_CHARS=10
RAG_PDF_SCAN_IMAGE_RATIO=0.5

# Durable background OCR. Docker supplies its shared spool and read-only import mount.
RAG_OCR_STORAGE_DIR=.local-ocr
RAG_OCR_IMPORT_ROOT=
RAG_OCR_MAX_JOB_PAGES=500
RAG_OCR_MAX_ATTEMPTS=3
RAG_OCR_RETRY_SECONDS=10
RAG_OCR_LEASE_SECONDS=360
RAG_OCR_SWEEP_SECONDS=20
RAG_OCR_MAX_PREVIEW_BYTES=67108864
RAG_OCR_CACHE_REVISION=mineru-middle2-adapter-v1

# Explicitly reviewed, paid OCR indexing; provider request-size cap is configurable.
RAG_OCR_INDEX_TIMEOUT=900
RAG_OCR_INDEX_MAX_CHUNKS=1000
EMBEDDING_PROVIDER_BATCH_LIMIT=10

# STR3/4: rules require no chat; multi-page OCR is explicit local-only.
RAG_QUERY_PLANNING_MODE=rules
RAG_QUERY_PLAN_MAX_PARTS=4
RAG_QUERY_PLAN_MAX_QUERIES=8
RAG_OCR_BOUNDARY_TIMEOUT=360
RAG_OCR_BOUNDARY_MAX_ATTEMPTS=3

# Only newly ingested or explicitly reviewed/rebuilt documents use this layout.
RAG_CHUNK_LAYOUT=structure

# STR6 only explicit offline experiments; these do not enable production model calls.
RAG_EXPERIMENT_MAX_CHUNKS=128
RAG_EXPERIMENT_MAX_SENTENCES=128
RAG_EXPERIMENT_SEMANTIC_THRESHOLD=0.65
RAG_EXPERIMENT_CONTEXT_MAX_CHARS=4096
RAG_EXPERIMENT_MAX_LLM_CALLS=8
RAG_EXPERIMENT_MAX_TOKENS=8192
RAG_EXPERIMENT_MAX_INPUT_BYTES=4194304

# Durable generation delivery and bounded SQL reconciliation (OPT-074).
GENERATION_MAINTENANCE_SECONDS=20
GENERATION_RECONCILE_BATCH_SIZE=50
GENERATION_DELIVERY_TIMEOUT_SECONDS=3600
GENERATION_STALE_ITEM_SECONDS=1800

# Optional dedicated Fernet key (generate once, persist separately from DB backups).
# Blank: legacy environment credentials work; saving provider keys in UI is disabled.
PROVIDER_SECRET_KEY=

# Bounded encrypted snapshots, separate key; legacy summaries remain unchanged.
TRACE_SNAPSHOT_ENABLED=false
TRACE_SNAPSHOT_SECRET_KEY=
TRACE_SNAPSHOT_MAX_BYTES=1048576
TRACE_SNAPSHOT_TOTAL_BYTES=134217728
TRACE_SNAPSHOT_RETENTION_DAYS=7
# Only purpose=fewshot, currently approved and human-reviewed examples are selected.
FEWSHOT_ENABLED=false
FEWSHOT_MAX_EXAMPLES=2
FEWSHOT_MAX_CHARS=8192
